# Copy this file to `.env.local` and replace the placeholders. Never commit
# `.env.local` because it contains deployment credentials and private values.

# Public Supabase settings used by the browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only allowlist; the account must have a confirmed email.
SUPABASE_ADMIN_EMAIL=owner@example.com
# Server-only Resend settings. The sender must use a domain verified in Resend.
RESEND_API_KEY=re_your_key
CONTACT_NOTIFICATION_FROM=Website <noreply@example.com>
# Optional; falls back to SUPABASE_ADMIN_EMAIL when omitted.
CONTACT_NOTIFICATION_TO=owner@example.com
# Optional production opt-out. Development and preview are already excluded.
ANALYTICS_DISABLED=false
