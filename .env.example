# This file is used to provide environment variables for your application. It is recommended to copy this file to a new file named `.env.local` and fill in the values with your own credentials. The `.env.local` file should not be committed to version control, as it may contain sensitive information.

# Supabase settings.
NEXT_PUBLIC_SUPABASE_URL=Project_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only allowlist; the account must have a confirmed email.
SUPABASE_ADMIN_EMAIL=Admin_Email
# Server-only Resend settings. The sender must use a domain verified in Resend.
RESEND_API_KEY=re_replace_me
CONTACT_NOTIFICATION_FROM=Personal Website <notifications@example.com>
# Optional; falls back to SUPABASE_ADMIN_EMAIL when omitted.
CONTACT_NOTIFICATION_TO=Your_Email
# Optional production opt-out. Development and preview are already excluded.
ANALYTICS_DISABLED=false
